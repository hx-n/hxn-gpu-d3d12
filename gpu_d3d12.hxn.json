          "docs": "Moves `texture` from state `before` to `after` (`State` bits).",
          "kind": "mutating",
          "params": [{ "name": "texture", "type": "Texture" }, { "name": "before", "type": "i32" }, { "name": "after", "type": "i32" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "uav_barrier",
          "docs": "Waits for unordered-access writes to `buffer` before later unordered access to it.",
          "kind": "mutating",
          "params": [{ "name": "buffer", "type": "Buffer" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "set_render_target",
          "docs": "Renders into `target`, which must be in the render target state, clearing it to\n`red`, `green`, `blue`, `alpha` or with `keep` drawing over what it holds, and sets the\nviewport and scissor to all of it.",
          "kind": "mutating",
          "params": [{ "name": "target", "type": "Texture" }, { "name": "keep", "type": "bool" }, { "name": "red", "type": "f64" }, { "name": "green", "type": "f64" }, { "name": "blue", "type": "f64" }, { "name": "alpha", "type": "f64" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "set_topology",
          "kind": "mutating",
          "params": [{ "name": "topology", "type": "Topology" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "set_vertex_buffer",
          "docs": "Binds `buffer` from `offset` bytes in to input slot `slot`, `stride` bytes per vertex or\ninstance.",
          "kind": "mutating",
          "params": [{ "name": "slot", "type": "i32" }, { "name": "buffer", "type": "Buffer" }, { "name": "stride", "type": "i32" }, { "name": "offset", "type": "i64" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "set_viewport",
          "docs": "Maps clip space onto the `width` by `height` pixels at `x`, `y` of the target.",
          "kind": "mutating",
          "params": [{ "name": "x", "type": "f64" }, { "name": "y", "type": "f64" }, { "name": "width", "type": "f64" }, { "name": "height", "type": "f64" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "set_scissor",
          "docs": "Draws only inside the `width` by `height` pixels at `x`, `y` of the target.",
          "kind": "mutating",
          "params": [{ "name": "x", "type": "i32" }, { "name": "y", "type": "i32" }, { "name": "width", "type": "i32" }, { "name": "height", "type": "i32" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "draw",
          "docs": "Draws `count` vertices from `first`, `instances` times.",
          "kind": "mutating",
          "params": [{ "name": "count", "type": "i32" }, { "name": "instances", "type": "i32" }, { "name": "first", "type": "i32" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "copy_buffer",
          "docs": "Copies all of `source` into `destination`, which must be at least as large.",
          "kind": "mutating",
          "params": [{ "name": "destination", "type": "Buffer" }, { "name": "source", "type": "Buffer" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "copy_texture_to_buffer",
          "docs": "Copies all of `texture`, in the copy source state, into `buffer`, rows\n`texture.copyPitch()` bytes apart.",
          "kind": "mutating",
          "params": [{ "name": "texture", "type": "Texture" }, { "name": "buffer", "type": "Buffer" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        }
      ]
    }
  ]
}
